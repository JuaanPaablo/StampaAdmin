# Repositorio de datos: 'memory' (por defecto, datos de ejemplo en memoria) o 'supabase'
STAMPA_REPO=memory

# Secreto con el que se firma la cookie de sesión (OBLIGATORIO en producción, mínimo 32 caracteres).
# Genéralo con:  openssl rand -base64 32
# Si lo cambias, todas las sesiones abiertas dejan de ser válidas. Nunca lo subas al repositorio.
# En desarrollo y pruebas, si falta, se usa un secreto fijo de desarrollo.
AUTH_SECRET=

# Solo con STAMPA_REPO=supabase (variables de servidor; la service role nunca va al navegador)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Herramientas de demostración (simular escaneos de clientes en cada código): on | off.
# Por defecto: activo en `npm run dev`, apagado en `npm start`. No afecta al inicio de sesión.
STAMPA_DEMO=

# Marketing con IA (solo servidor, NUNCA con prefijo NEXT_PUBLIC_). Ver docs/MARKETING.md.
# Textos: DeepSeek (modelo Flash, sin modo de razonamiento). Sin clave, en desarrollo se devuelven textos de ejemplo.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Fotos: mejora con IA vía fal.ai (Seedream 5.0 Lite Edit, ~US$0,035 por foto). Sin clave, en desarrollo se simula.
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/edit

# Google Wallet (Android). Ver docs/WALLET.md. Sin estas dos, el botón "Agregar a Google Wallet" no aparece.
# GOOGLE_WALLET_SA_JSON_BASE64 = la clave JSON de la cuenta de servicio convertida a base64 (Sensitive en Vercel).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON_BASE64=
